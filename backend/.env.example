# Google Generative AI API Key
GOOGLE_API_KEY=<YOUR_GOOGLE_API_KEY>

# Pinecone API Key
PINECONE_API_KEY=<YOUR_PINECONE_API_KEY>


# PostgreSQL Credentials
DB_NAME=example_db          # database name (example value)
DB_USER=example_user        # database user (example value)
DB_PASSWORD=example_password  # database password (example value)
DB_HOST=localhost           # database host (default value)
DB_PORT=5432                # database port (PostgreSQL default port)